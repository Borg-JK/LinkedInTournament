rules_version = '2';

// Phase 1-5 scope: users, usernames, friends, friendRequests, tournaments,
// scores. Everything not explicitly matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // One fact per person per game per day, global — not scoped to any
    // tournament (tournaments only ever read from here, filtered to their
    // own games/members; see lib/standings.js). A user can only write their
    // own scores, for any of the five games — Phase 1 dropped the idea of a
    // fixed "games I play" list, so there's nothing to gate write access on
    // beyond the game being a real one. Read access is broad (any signed-in
    // user), matching the same openness already given to users/tournaments/
    // usernames — this is a small friend-group app, and computing shared
    // standings needs every tournament member to be able to read every
    // other member's relevant scores anyway.
    match /scores/{uid}/{game}/{date} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && game in ['queens', 'tango', 'mini', 'zip', 'patches']
                   && request.resource.data.timeSeconds is number
                   && request.resource.data.timeSeconds > 0
                   && request.resource.data.puzzleNum is number;
    }

    // Public profile doc, one per account. Any signed-in user can read (needed for
    // friend search, leaderboards, tournament member lists later); only the owner
    // can create/update their own doc. Deletion is not supported in Phase 1.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // One doc per friendship, keyed by the friend's uid. A user can write
      // their own friends list (e.g. removing someone), AND can write
      // themselves into someone else's friends list, keyed by their own uid —
      // that second case is how accepting a friend request creates the
      // reciprocal entry client-side, without a Cloud Function in the loop.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // Incoming friend request, keyed by the sender's uid, living under the
      // recipient's (uid's) tree. Either party can read one specific request
      // doc (recipient sees their inbox; sender can check whether they've
      // already got one pending, to avoid duplicates) — but list queries only
      // resolve for the recipient, since only uid == request.auth.uid can see
      // the whole subcollection.
      match /friendRequests/{fromUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == fromUid);
        // Sending a request: only the sender can create it, under the
        // recipient's tree, and only as 'pending'.
        allow create: if request.auth != null && request.auth.uid == fromUid
                      && request.resource.data.status == 'pending';
        // Accepting/declining: the recipient (owner) resolves it. The sender
        // may also delete their own outgoing request to cancel it.
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
                      && (request.auth.uid == uid || request.auth.uid == fromUid);
      }

      // Incoming tournament invite, keyed by the tournament id, living under
      // the invitee's (uid's) tree. Only that tournament's owner may create
      // one (checked via get() on the tournament doc); the invitee resolves
      // it by accepting (which also writes their own membership — see
      // tournaments/{id} update rule below) or declining (delete). The owner
      // may also delete it to cancel/re-invite.
      match /tournamentInvites/{tournamentId} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid
                        || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow create: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId
                      && request.resource.data.status == 'pending';
        allow delete: if request.auth != null
                      && (request.auth.uid == uid
                          || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow update: if false;
      }

      // Mirror of tournaments/{id}/waitlist/{uid} (below), kept under the
      // waitlisted user's own tree so they can list "tournaments I'm waiting
      // on" without a collection-group query. Written by whoever resolves
      // the invite/join-request under a 'monthly' join policy — the invitee
      // themselves (accepting an invite) or the tournament owner (approving
      // a join request) — and cleared by the user once they self-promote.
      match /waitlisted/{tournamentId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
                      && (request.auth.uid == uid
                          || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow update: if false;
      }
    }

    // Tournament configuration + membership — no scores here (Phase 5's global
    // scores collection is the source of truth; standings are always computed
    // on the fly from there, filtered to this doc's games/members).
    //
    // Membership model: nobody is added unilaterally. An owner-sent invite
    // (users/{invitee}/tournamentInvites/{tournamentId}) needs the invitee to
    // accept; a self-service join request (joinRequests/{uid} below) needs the
    // owner to approve. Under joinPolicy 'monthly', either resolution parks
    // the person on the waitlist (below) instead of writing `members`
    // directly — they self-promote once their eligibleFrom date has passed
    // (there's no server-side scheduler in this app, so that happens lazily,
    // the next time they load the app — see lib/useTournaments.js). The
    // owner can also remove a member, or edit name/games/scoringMetric/
    // eligibilityThresholdPct/startDate/joinPolicy, at any time, and delete
    // the tournament entirely. ownerId itself is immutable — no ownership
    // transfer yet.
    match /tournaments/{tournamentId} {
      // Readable by any signed-in user — tournaments are discoverable by
      // name search (Phase 3), not just visible to current members.
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid]
                    && request.resource.data.games is list
                    && request.resource.data.games.size() > 0
                    && request.resource.data.scoringMetric in ['simple', 'ratio', 'median', 'average']
                    && request.resource.data.eligibilityThresholdPct in [20, 25, 30, 35, 40, 45, 50]
                    && request.resource.data.joinPolicy in ['anytime', 'monthly']
                    && request.resource.data.startDate is string
                    && request.resource.data.status == 'active'
                    && request.resource.data.nameLower == request.resource.data.name.lower();
      allow update: if request.auth != null && (
        // Owner: full control over settings and membership (add/remove
        // anyone, e.g. approving a join request or kicking a member),
        // except ownerId itself.
        (request.auth.uid == resource.data.ownerId
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.games is list && request.resource.data.games.size() > 0
         && request.resource.data.scoringMetric in ['simple', 'ratio', 'median', 'average']
         && request.resource.data.eligibilityThresholdPct in [20, 25, 30, 35, 40, 45, 50]
         && request.resource.data.joinPolicy in ['anytime', 'monthly']
         && request.resource.data.startDate is string
         && request.resource.data.nameLower == request.resource.data.name.lower())
        ||
        // Invitee accepting (anytime policy): may only append their own uid
        // to members — nothing else on this doc may change — and only with
        // a pending invite on file.
        (!(request.auth.uid in resource.data.members)
         && request.auth.uid in request.resource.data.members
         && request.resource.data.members == resource.data.members.concat([request.auth.uid])
         && exists(/databases/$(database)/documents/users/$(request.auth.uid)/tournamentInvites/$(tournamentId))
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.games == resource.data.games
         && request.resource.data.scoringMetric == resource.data.scoringMetric
         && request.resource.data.eligibilityThresholdPct == resource.data.eligibilityThresholdPct
         && request.resource.data.joinPolicy == resource.data.joinPolicy
         && request.resource.data.startDate == resource.data.startDate
         && request.resource.data.name == resource.data.name
         && request.resource.data.nameLower == resource.data.nameLower
         && request.resource.data.status == resource.data.status)
        ||
        // Waitlisted member self-promoting (monthly policy): may only append
        // their own uid to members, once their own waitlist doc's
        // eligibleFrom timestamp has passed — everything else unchanged.
        (!(request.auth.uid in resource.data.members)
         && request.auth.uid in request.resource.data.members
         && request.resource.data.members == resource.data.members.concat([request.auth.uid])
         && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/waitlist/$(request.auth.uid))
         && request.time > get(/databases/$(database)/documents/tournaments/$(tournamentId)/waitlist/$(request.auth.uid)).data.eligibleFrom
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.games == resource.data.games
         && request.resource.data.scoringMetric == resource.data.scoringMetric
         && request.resource.data.eligibilityThresholdPct == resource.data.eligibilityThresholdPct
         && request.resource.data.joinPolicy == resource.data.joinPolicy
         && request.resource.data.startDate == resource.data.startDate
         && request.resource.data.name == resource.data.name
         && request.resource.data.nameLower == resource.data.nameLower
         && request.resource.data.status == resource.data.status)
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Authoritative per-member record (role, joinedAt). Written only after
      // the parent doc exists, so get() here can see it.
      match /members/{memberUid} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.members;
        allow create: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId
          || (request.auth.uid == memberUid
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/tournamentInvites/$(tournamentId)))
          || (request.auth.uid == memberUid
              && exists(/databases/$(database)/documents/tournaments/$(tournamentId)/waitlist/$(memberUid))
              && request.time > get(/databases/$(database)/documents/tournaments/$(tournamentId)/waitlist/$(memberUid)).data.eligibleFrom)
        );
        // No self-leave yet — only the owner can remove a member (keeps the
        // members/{uid} doc and the parent's `members` array in sync; a
        // self-leave would need its own array-removal branch on the parent).
        allow delete: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId;
        allow update: if false;
      }

      // Self-service join request, keyed by the requester's uid. Either the
      // requester (to cancel) or the owner (to approve/decline) can remove it.
      match /joinRequests/{requesterUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == requesterUid
                        || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow create: if request.auth != null && request.auth.uid == requesterUid
                      && request.resource.data.status == 'pending';
        allow delete: if request.auth != null
                      && (request.auth.uid == requesterUid
                          || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow update: if false;
      }

      // Holds people waiting for the next calendar month under a 'monthly'
      // joinPolicy — see the tournaments/{id} update rule above for the
      // self-promotion path. Created either by the invitee themselves
      // (accepting an invite) or by the owner (approving a join request);
      // removed by the waitlisted user (once they self-promote) or the owner.
      match /waitlist/{waitlistUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == waitlistUid
                        || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow create: if request.auth != null
                      && request.resource.data.eligibleFrom is timestamp
                      && (request.auth.uid == waitlistUid
                          || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow delete: if request.auth != null
                      && (request.auth.uid == waitlistUid
                          || request.auth.uid == get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId);
        allow update: if false;
      }
    }

    // username (lowercased) -> uid lookup, used for uniqueness checks at signup
    // and for username search later. Readable by anyone signed in. A username can
    // only be created by the uid it points to, and only if it isn't already taken —
    // this is the source of truth for uniqueness, the client-side check is just UX.
    // Immutable once claimed for now (no rename support yet — flagged to Borg).
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }
  }
}
