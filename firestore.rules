rules_version = '2';

// Phase 1 scope: users + usernames only. Friends (Phase 2), tournaments (Phase 3),
// and scores (Phase 5) collections get their own rules blocks added in those phases.
// Everything not explicitly matched below is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile doc, one per account. Any signed-in user can read (needed for
    // friend search, leaderboards, tournament member lists later); only the owner
    // can create/update their own doc. Deletion is not supported in Phase 1.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // username (lowercased) -> uid lookup, used for uniqueness checks at signup
    // and for username search later. Readable by anyone signed in. A username can
    // only be created by the uid it points to, and only if it isn't already taken —
    // this is the source of truth for uniqueness, the client-side check is just UX.
    // Immutable once claimed for now (no rename support yet — flagged to Borg).
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }
  }
}
